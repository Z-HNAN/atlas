name = "atlas-sync"
main = "src/index.ts"
compatibility_date = "2026-07-30"

[vars]
ACCESS_ISSUER = "https://your-team.cloudflareaccess.com"
ACCESS_AUD = "replace-with-access-application-aud"
ALLOWED_ORIGINS = "http://localhost:5173,https://your-atlas.vercel.app"

[[d1_databases]]
binding = "DB"
database_name = "app-sync"
database_id = "replace-with-d1-database-id"

[[r2_buckets]]
binding = "SNAPSHOTS"
bucket_name = "app-sync-snapshots"

[triggers]
crons = ["17 3 * * *"]
